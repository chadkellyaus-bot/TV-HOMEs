plugins { id 'com.android.application' }

android {
    namespace 'org.tvhome.launcher'
    compileSdk 34
    defaultConfig {
        applicationId 'org.tvhome.launcher'
        minSdk 24
        targetSdk 30
        versionCode 1
        versionName '1.0'
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }
}

